# Git ignore rules for flux-vprint

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# RPM build artifacts
*.rpm
rpmbuild/

# Firmware & temporary download files
*.exe
*.bin
*.xpfwext
/firmware/*.exe
/firmware/*.xpfwext

# System & desktop environment files
.directory
.DS_Store
Thumbs.db
*~
*.swp

# Logs and databases
*.log

